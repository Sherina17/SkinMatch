{
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/style.css",
      "destination": "/api/index"
    },
    {
      "source": "/script.js",
      "destination": "/api/index"
    },
    {
      "source": "/image/:path*",
      "destination": "/api/index"
    }
  ]
}